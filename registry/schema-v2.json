{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "biblioteka-vsp/registry/v2",
  "title": "biblioteka-vsp registry v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "updated", "source", "scope", "books", "electronic_holdings"],
  "properties": {
    "schema": {"const": "biblioteka-vsp/registry/v2"},
    "updated": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256", "size_bytes", "sheets"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sheets": {"type": "object", "additionalProperties": {"type": "string"}, "minProperties": 1}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "book_count"],
      "properties": {
        "purpose": {"type": "string", "minLength": 1},
        "book_count": {"type": "integer", "minimum": 0}
      }
    },
    "books": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["number", "inventory_number", "title", "authors_raw", "translators_editors_raw", "summary_short", "direction"],
        "properties": {
          "number": {"type": "integer", "minimum": 1},
          "inventory_number": {"type": "string", "pattern": "^[0-9]{4}$"},
          "knowledge_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "title": {"type": "string", "minLength": 1},
          "authors_raw": {"type": "string", "minLength": 1},
          "translators_editors_raw": {"type": "string"},
          "summary_short": {"type": "string", "minLength": 1},
          "direction": {"type": "string", "minLength": 1},
          "domains": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}, "uniqueItems": true},
          "topics": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}, "uniqueItems": true},
          "level": {"enum": ["introductory", "intermediate", "advanced", "[Needs confirmation]"]}
        }
      }
    },
    "verification_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["inventory_number", "title", "checked", "basis", "source_url"],
        "properties": {
          "inventory_number": {"type": "string", "pattern": "^[0-9]{4}$"},
          "title": {"type": "string"},
          "checked": {"type": "string"},
          "basis": {"type": "string"},
          "source_url": {"type": ["string", "null"]}
        }
      }
    },
    "electronic_holdings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "observed_date", "file_count", "matched_unambiguous", "needs_confirmation", "unregistered", "files"],
      "properties": {
        "source": {"type": "string"},
        "observed_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "file_count": {"type": "integer", "minimum": 0},
        "matched_unambiguous": {"type": "integer", "minimum": 0},
        "needs_confirmation": {"type": "integer", "minimum": 0},
        "unregistered": {"type": "integer", "minimum": 0},
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["filename", "format", "match_status", "inventory_numbers"],
            "properties": {
              "filename": {"type": "string", "minLength": 1},
              "format": {"type": "string", "minLength": 1},
              "match_status": {"enum": ["matched", "ambiguous", "needs_confirmation", "unregistered"]},
              "inventory_numbers": {"type": "array", "items": {"type": "string", "pattern": "^[0-9]{4}$"}, "uniqueItems": true},
              "note": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
